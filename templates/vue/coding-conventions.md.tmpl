# Coding Conventions — Vue 3

## Script Setup (Required)

```vue
<!-- ✅ Correct — always use <script setup> -->
<script setup lang="ts">
import { ref, computed } from 'vue';
import { useUserStore } from '@/stores/useUserStore';

const props = defineProps<{ userId: number }>();
const emit = defineEmits<{ update: [value: string] }>();

const store = useUserStore();
const userName = computed(() => store.getUserById(props.userId)?.name);
</script>

<!-- ❌ Wrong — do not use Options API -->
<script>
export default { data() { return {} } }
</script>
```

---

## Composables Pattern

```typescript
// composables/useAuth.ts
export function useAuth() {
  const user = ref<User | null>(null);
  const isLoggedIn = computed(() => !!user.value);

  async function login(credentials: Credentials) { ... }
  async function logout() { ... }

  return { user, isLoggedIn, login, logout };
}
```

- Naming: `use<Domain>` — `useAuth`, `useCart`, `usePagination`
- Return reactive refs — do not return raw values

---

## API Integration in Composable

Standard pattern for async data fetching:

```typescript
// composables/useUsers.ts
export function useUsers() {
  const users = ref<User[]>([]);
  const isLoading = ref(false);
  const error = ref<string | null>(null);

  async function fetchUsers() {
    isLoading.value = true;
    error.value = null;
    try {
      users.value = await userService.getAll();
    } catch (e) {
      error.value = e instanceof Error ? e.message : 'Unknown error';
    } finally {
      isLoading.value = false;
    }
  }

  return { users, isLoading, error, fetchUsers };
}
```

Templates always handle 3 states: `isLoading`, `error`, `data`.

